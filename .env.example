# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL 16 connection string (local or Kontabo VPS)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/workstation_dev"

# JWT_SECRET: Cryptographic salt for HMAC-SHA256 token signing (min 32 characters)
JWT_SECRET="workstation-production-secret-change-this-in-production-min32chars"


# Auth rate limiting (SEC-02): login attempts per IP per window
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=5

# Agent telemetry ingestion token (Epic 9): shared secret for workstation agents
AGENT_INGEST_TOKEN=

# Workstation Agent daemon (Epic 9) — runs on monitored Linux servers
AGENT_SERVER_URL=http://localhost:3000
AGENT_TOKEN=change-me-agent-token
AGENT_SERVER_NAME=kantor-01
AGENT_INTERVAL_SECONDS=60
AGENT_BUFFER_MAX=60

# Service probes (Epic 11) — format: name:kind:host:port;... (kind = http|tcp)
AGENT_SERVICES=nginx:http:127.0.0.1:80;mysql:tcp:127.0.0.1:3306;redis:tcp:127.0.0.1:6379
AGENT_PROBE_TIMEOUT_MS=3000

# Story 17.2 (CC-4) — Demo Data Gating:
# kosong/tidak diset = boot produksi (data nyata via API, tanpa mock).
# VITE_DEMO_MODE=1 = seed data demo statis + banner label demo yang jelas.
VITE_DEMO_MODE=

# Story 20.1 (CC-6) — Report Scheduler Cron: laporan terjadwal produksi.
# REPORT_SCHEDULER=on mengaktifkan generate otomatis DAILY/WEEKLY/MONTHLY (default off).
REPORT_SCHEDULER=
REPORT_SCHEDULER_TZ=Asia/Jakarta
REPORT_CRON_DAILY="0 7 * * *"
REPORT_CRON_WEEKLY="0 7 * * 1"
REPORT_CRON_MONTHLY="0 7 1 * *"

# Story 20.2 (CC-6) — Email Delivery laporan terjadwal (nodemailer SMTP).
# Tidak lengkap → delivery graceful SKIP (tercatat SKIPPED di report_deliveries).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Penerima laporan terjadwal, dipisah koma (kosong = tidak ada pengiriman email).
REPORT_DELIVERY_EMAILS=

# Story 20.3 (CC-6) — WhatsApp Delivery laporan terjadwal (gateway HTTP generik,
# kompatibel pola Fonnte/Wablas). Tidak lengkap → graceful SKIP tercatat.
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=
# Nomor penerima format internasional tanpa "+", dipisah koma.
REPORT_DELIVERY_WA_NUMBERS=
